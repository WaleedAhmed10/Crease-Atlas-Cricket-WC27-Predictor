# --- Server (copy to server/.env) ---
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crease_atlas
# DATABASE_SSL=true            # hosted Postgres (Neon, Supabase, Render...) usually needs this
CORS_ORIGIN=http://localhost:5173
SESSION_DAYS=14
# TRUST_PROXY=1                # defaults to 1 hop in production (needed behind Render/Railway/Fly/nginx)
# ADMIN_KEY=choose-a-long-random-string   # enables POST /api/admin/reseed (reload CSVs without redeploy)
